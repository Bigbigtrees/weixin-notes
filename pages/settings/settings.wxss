.page {
  padding: 24rpx;
  background-color: var(--theme-bg);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--theme-text);
  margin: 24rpx 0 16rpx;
}

.theme-list {
  display: flex;
  gap: 16rpx;
}

.theme-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  border-radius: 12rpx;
  background-color: var(--theme-card);
  border: 2rpx solid var(--theme-border);
  font-size: 28rpx;
  color: var(--theme-text-secondary);
}

.theme-option-active {
  border-color: var(--theme-text);
  color: var(--theme-text);
  font-weight: 600;
}

.theme-option-check {
  color: var(--theme-text);
  font-weight: 700;
}

.signature-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background-color: var(--theme-card);
  border-radius: 12rpx;
  border: 1rpx solid var(--theme-border);
}

.signature-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--theme-text);
  background-color: var(--theme-bg);
}

.signature-save {
  flex-shrink: 0;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: normal;
}

.reset-row {
  text-align: right;
  margin-top: 16rpx;
}

.reset-text {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}
