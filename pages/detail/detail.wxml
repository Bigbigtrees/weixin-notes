<view class="page" data-theme="{{theme}}" wx:if="{{note}}">
  <view class="note-detail">
    <text class="note-detail-title">{{note.title}}</text>
    <text class="note-detail-meta">{{note.createdAt}} 添加</text>
  </view>

  <view class="action-bar">
    <!-- 分享入口：open-type="share" 由微信平台自动触发 onShareAppMessage 转发通道，签名随转发携带（AC-4）。
         微信朋友圈分享依赖平台 onShareTimeline（右上角「分享到朋友圈」菜单触发），无法用普通按钮直接触发（AC-3/AC-4）。 -->
    <button class="action-btn share-btn" open-type="share">转发给好友</button>
  </view>
</view>
