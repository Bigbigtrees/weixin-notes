.page {
  padding: 24rpx;
  background-color: var(--theme-bg);
}

.note-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  background-color: var(--theme-card);
  border-radius: 12rpx;
  border: 1rpx solid var(--theme-border);
}

.note-detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--theme-text);
}

.note-detail-meta {
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.action-bar {
  padding: 20rpx 24rpx;
}

.action-btn {
  display: block;
  width: 100%;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background-color: var(--theme-card);
  color: var(--theme-text);
  font-size: 28rpx;
  line-height: normal;
  border: 1rpx solid var(--theme-border);
}
