<view class="page" data-theme="{{theme}}">
  <view class="header">
    <text class="header-title">我的笔记</text>
    <view class="header-settings" role="button" aria-label="打开主题与分享签名设置" bindtap="goSettings">主题 / 签名设置</view>
  </view>
  <text class="header-hint">点击标题查看笔记，可分享到朋友圈</text>

  <view class="note-list">
    <view
      class="note-item"
      wx:for="{{notes}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <text class="note-item-title">{{item.title}}</text>
      <text class="note-item-meta">{{item.createdAt}} 添加</text>
      <text class="note-item-del" data-id="{{item.id}}" catchtap="deleteNote">删除</text>
    </view>

    <view class="add-note">
      <text class="add-note-title">新增笔记</text>
      <input
        class="add-note-input"
        type="text"
        value="{{noteTitle}}"
        bindinput="onInput"
        placeholder="输入笔记标题"
      />
      <button class="add-note-save" bindtap="addNote">添加</button>
    </view>
  </view>
</view>
